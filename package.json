{
  "name": "helixsr-muse-plugin",
  "version": "0.6.11",
  "description": "HelixSR Decky plugin.",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/gen-version.js",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests -v && pnpm run test:ui",
    "test:ui": "tsc src/utils.ts --outDir .uitest --module es2020 --target es2020 --moduleResolution node && node --test tests_ui/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enzodiloreto/helixsr-decky-plugin-muse.git"
  },
  "keywords": [
    "decky",
    "helixsr",
    "steam-deck",
    "deck"
  ],
  "author": "Enzo",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/enzodiloreto/helixsr-decky-plugin-muse/issues"
  },
  "homepage": "https://github.com/enzodiloreto/helixsr-decky-plugin-muse#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
